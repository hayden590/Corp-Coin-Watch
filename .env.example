# Copy to .env and fill in. NEVER commit .env.
# Everything is optional for --dry-run.

# --- Alerts ---
# Pop-ups on your laptop AND phone via ntfy (free). Make up a long random topic name - it works
# like a password: anyone who knows it can read your alerts. Generate one with:
#   python main.py new-ntfy-topic
NTFY_TOPIC=
# Only if you use an ntfy account / your own ntfy server with access control:
NTFY_TOKEN=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram reading via your own account (phase 2) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- X burner accounts for twscrape (phase 3) ---
# One per line as username:password:email:email_password, separated by ';'
X_ACCOUNTS=
# Or cookie strings, separated by ';' (username=cookie_string)
X_COOKIES=

# --- On-chain (phase 4) ---
# Helius free tier: Solana smart-wallet tracking + global fees paid
HELIUS_API_KEY=
# Optional: EVM wallet tracking on BSC/Arbitrum/Polygon (Ethereum/Base work without it via Blockscout)
ETHERSCAN_API_KEY=
# Optional: chart fallback when GeckoTerminal has no data
BIRDEYE_API_KEY=
# Optional: follow Fomo's leaderboard traders. Free key from https://fomoapi.io (sign in with an email code).
FOMO_API_KEY=

# --- Optional AI text analysis (phase 6) ---
ANTHROPIC_API_KEY=
